{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fileboat",
  "version": "0.5.0",
  "identifier": "app.fileboat",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Fileboat",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: http://fbpreview.localhost fbpreview: http://fbicon.localhost fbicon:; media-src http://fbpreview.localhost fbpreview:; font-src 'self' http://fbpreview.localhost fbpreview:; frame-src http://fbpreview.localhost fbpreview:; connect-src ipc: http://ipc.localhost http://fbpreview.localhost fbpreview:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "publisher": "Fileboat",
    "copyright": "Copyright (c) 2026 Yash Desai. MIT License.",
    "category": "DeveloperTool",
    "shortDescription": "A small, fast file explorer for developers",
    "longDescription": "Fileboat: a file explorer for developers with live git, fast search, previews and Claude Code built in."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM4REJCMkQ3MjEwOThDRDYKUldUV2pBa2gxN0xiT1B2R08wQ3lXeEh0a2REbmhJUHk5b1kxazlYY1p0Q3BCblc1ajBSTml2YXAK",
      "endpoints": [
        "https://github.com/yash-desai-naik/fileboat/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
